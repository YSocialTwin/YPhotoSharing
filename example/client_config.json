        "Neutral": [0.4, 0.6],
        "Agree": [0.6, 0.8],
        "Strongly agree": [0.8, 1.0]
      }
    },
    "agents": {
      "probability_of_secondary_follow": 0.1,
      "probability_of_follow_back": 0.1
