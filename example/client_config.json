{
  "client_id": "client_001",
  "server_name": "orchestrator_server",
  "namespace": "yphotosharing",
  "address": "auto",
  "users_file": "users.json",
  "simulation": {
    "num_rounds": 48,
    "start_day": 0,
    "use_local_diffusion": true,
    "local_diffusion_model": "segmind/tiny-sd",
