    "hourly_activity": {
        "0": 0.2, "1": 0.1, "2": 0.05, "3": 0.05, "4": 0.1, "5": 0.2,
        "6": 0.4, "7": 0.6, "8": 0.8, "9": 0.9, "10": 0.8, "11": 0.8,
        "12": 0.9, "13": 0.9, "14": 0.8, "15": 0.8, "16": 0.8, "17": 0.9,
        "18": 1.0, "19": 1.0, "20": 1.0, "21": 0.9, "22": 0.6, "23": 0.4
